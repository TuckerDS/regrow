# Compilaciones y artefactos — no se versionan
/build/*
!/build/.gitkeep

# Cargo (target por defecto; el target real apunta a build/ vía .cargo/config.toml)
/target/

# Datos producidos al ejecutar el programa desde el repo
/diskstats/
/backup/

# Binarios sueltos
*.o
*.d

# SO
.DS_Store

# Fixtures binarios extraídos de volumenes reales: privados, nunca al repo.
# Los tests que los usan se saltan limpiamente si faltan.
/tests/fixtures/
